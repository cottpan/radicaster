<?xml version="1.0" encoding="UTF-8" ?>
<rss xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd" version="2.0">
  <channel>
    <title><%= escape.call(definition.title) %></title>
    <itunes:author><%= escape.call(definition.author) %></itunes:author>
    <itunes:summary><%= escape.call(definition.summary) %></itunes:summary>
    <% if definition.image %>
    <itunes:image href="<%= escape.call(definition.image) %>"/>
    <% end %>
    <% episodes.each do |ep| %>
    <item>
      <title><%= escape.call(ep.title) %></title>
      <itunes:author><%= escape.call(definition.author) %></itunes:author>
      <% if definition.image %>
      <itunes:image href="<%= escape.call(definition.image) %>"/>
      <% end %>
      <pubDate><%= ep.last_modified.rfc822 %></pubDate>
      <enclosure url="<%= escape.call(ep.url) %>" length="<%= ep.size %>" type="audio/mp4"/>
    </item>
    <% end %>
  </channel>
</rss>
